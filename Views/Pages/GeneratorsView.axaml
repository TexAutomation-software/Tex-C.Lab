<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:vm="using:PCRA.ViewModels.Pages"
    x:Class="PCRA.Views.Pages.GeneratorsView"
	x:DataType="vm:GeneratorsViewModel">

	<Grid RowDefinitions="Auto,*">

		<!-- Header -->

		<Grid RowDefinitions="Auto,*">

			<Border Classes="GeneratorCard"
					Margin="30,25,30,10">

				<StackPanel>

					<TextBlock Text="Generators"
							   FontSize="32"
							   FontWeight="Bold"
							   Foreground="White"/>

					<TextBlock Text="Create encrypted controller files"
							   Margin="0,5,0,0"
							   Classes="GeneratorSubtitle"/>

				</StackPanel>

			</Border>

		</Grid>

		<!-- Content -->

		<ScrollViewer Grid.Row="1">

			<Grid Margin="30"
                  RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                  ColumnSpacing="20"
                  RowSpacing="20">

				<!-- LOGIN -->

				<Border Grid.Row="0"
                        Classes="GeneratorCard">

					<StackPanel Spacing="12">

						<TextBlock Classes="GeneratorTitle"
                                   Text="Generate login file"/>

						<TextBlock Classes="GeneratorDescription"
                                   Text="login.enc"/>

						<TextBox Text="{Binding LoginPassword}"
								PasswordChar="*"
								PlaceholderText="Password"/>


						<Button Content="Generate LOGIN"
								Command="{Binding GenerateLoginCommand}"/>

					</StackPanel>

				</Border>

				<!-- CHANGE PASSWORD -->

				<Border Grid.Row="1"
                        Classes="GeneratorCard">

					<StackPanel Spacing="12">

						<TextBlock Classes="GeneratorTitle"
                                   Text="Generate password change file"/>

						<TextBlock Classes="GeneratorDescription"
                                   Text="changePwd.enc"/>

						<TextBox Watermark="New password"
								Text="{Binding ChangePassword}"
								PasswordChar="*"
								PlaceholderText="Password"/>

						<Button Content="Generate CHANGEPWD"
								Command="{Binding GenerateChangePasswordCommand}"/>

					</StackPanel>

				</Border>

				<!-- RESET -->

				<Border Grid.Row="2"
						Classes="GeneratorCard">

					<StackPanel Spacing="12">

						<TextBlock Classes="GeneratorTitle"
								   Text="Generate reset password file"/>

						<TextBlock Classes="GeneratorSubtitle"
								   Text="reset.enc"/>

						<Grid RowDefinitions="Auto,Auto,Auto,Auto"
							  RowSpacing="12">

							<!-- Row 1: MAC address -->
							<TextBox Grid.Row="0"
									 Watermark="00:11:22:33:44:55"
									 Text="{Binding MacAddressReset}"/>

							<!-- Expiration values are entered and displayed in UTC. -->
							<TextBlock Grid.Row="1"
									   Text="Expiration date and time (UTC)"
									   Classes="GeneratorSubtitle"/>

							<!-- Date/time picker on the left, quick buttons on the right -->
							<Grid Grid.Row="2"
								  ColumnDefinitions="*,Auto"
								  ColumnSpacing="12">

								<!-- Left side: expiration date and time -->
								<Grid Grid.Column="0"
									  ColumnDefinitions="*,*"
									  ColumnSpacing="12">

									<DatePicker Grid.Column="0"
												SelectedDate="{Binding ResetDate}"/>

									<TimePicker Grid.Column="1"
												SelectedTime="{Binding ResetTime}"/>

								</Grid>

								<!-- Right side: quick expiration buttons -->
								<StackPanel Grid.Column="1"
											Orientation="Horizontal"
											Spacing="6">
									<Button Content="1 hour"
											Command="{Binding SetResetOneHourCommand}"/>
									<Button Content="12 hours"
											Command="{Binding SetResetTwelveHoursCommand}"/>
									<Button Content="1 day"
											Command="{Binding SetResetOneDayCommand}"/>
									<Button Content="2 days"
											Command="{Binding SetResetTwoDaysCommand}"/>
									<Button Content="1 week"
											Command="{Binding SetResetOneWeekCommand}"/>
								</StackPanel>

							</Grid>

							<!-- Generate button -->
							<Button Grid.Row="3"
									Classes="Primary"
									Content="Generate RESET"
									Command="{Binding GenerateResetCommand}"/>

						</Grid>

					</StackPanel>

				</Border>


				<!-- CARDPARS -->

				<Border Grid.Row="3"
                        Classes="GeneratorCard">

					<StackPanel Spacing="12">

						<TextBlock Classes="GeneratorTitle"
                                   Text="Encrypt CardPars file"/>

						<TextBlock Classes="GeneratorDescription"
                                   Text="cardPars.enc"/>

						<Grid ColumnDefinitions="*,Auto">

							<TextBox Name="CardParsFileBox"
									 Text="{Binding CardParsFile}"
									 Watermark="Select .CRD file"/>

							<Button Grid.Column="1"
                                    Margin="10,0,0,0"
                                    Content="Browse"
                                    Click="BrowseCardPars_Click"/>

						</Grid>

						<Button Content="Generate CARDPARS"
								Command="{Binding GenerateCardParsCommand}"/>

					</StackPanel>

				</Border>

				<!-- CHECKSUM -->

				<Border Grid.Row="4"
                        Classes="GeneratorCard">

					<StackPanel Spacing="12">

						<TextBlock Classes="GeneratorTitle"
                                   Text="Generate checksum file"/>

						<TextBlock Classes="GeneratorDescription"
                                   Text="checsum.enc"/>

						<Grid ColumnDefinitions="*,Auto">

							<TextBox Name="ChecksumFileBox"
									 Text="{Binding ChecksumFile}"
									 Watermark="Select BIN file"/>

							<Button Grid.Column="1"
                                    Margin="10,0,0,0"
                                    Content="Browse"
                                    Click="BrowseChecksum_Click"/>

						</Grid>

						<Button Content="Generate CHECKSUM"
								Command="{Binding GenerateChecksumCommand}"/>

					</StackPanel>

				</Border>

				<!-- TEMPAUTH  -->

				<Border Grid.Row="5"
						Classes="GeneratorCard">

					<StackPanel Spacing="12">

						<TextBlock Classes="GeneratorTitle"
								   Text="Generate temporary authorization"/>

						<TextBlock Classes="GeneratorSubtitle"
								   Text="tempauth.enc"/>

						<Grid RowDefinitions="Auto,Auto,Auto,Auto"
							  RowSpacing="12">

							<!-- Row 1: MAC address -->
							<TextBox Grid.Row="0"
									 Watermark="00:11:22:33:44:55"
									 Text="{Binding MacAddressTempAuth}"/>

							<!-- Expiration values are entered and displayed in UTC. -->
							<TextBlock Grid.Row="1"
									   Text="Expiration date and time (UTC)"
									   Classes="GeneratorSubtitle"/>

							<!-- Date/time picker on the left, quick buttons on the right -->
							<Grid Grid.Row="2"
								  ColumnDefinitions="*,Auto"
								  ColumnSpacing="12">

								<!-- Left side: expiration date and time -->
								<Grid Grid.Column="0"
									  ColumnDefinitions="*,*"
									  ColumnSpacing="12">

									<DatePicker Grid.Column="0"
												SelectedDate="{Binding TempAuthDate}"/>

									<TimePicker Grid.Column="1"
												SelectedTime="{Binding TempAuthTime}"/>

								</Grid>

								<!-- Right side: quick expiration buttons -->
								<StackPanel Grid.Column="1"
											Orientation="Horizontal"
											Spacing="6">
									<Button Content="1 hour"
											Command="{Binding SetTempAuthOneHourCommand}"/>
									<Button Content="12 hours"
											Command="{Binding SetTempAuthTwelveHoursCommand}"/>
									<Button Content="1 day"
											Command="{Binding SetTempAuthOneDayCommand}"/>
									<Button Content="2 days"
											Command="{Binding SetTempAuthTwoDaysCommand}"/>
									<Button Content="1 week"
											Command="{Binding SetTempAuthOneWeekCommand}"/>
								</StackPanel>

							</Grid>

							<!-- Generate button -->
							<Button Grid.Row="3"
									Classes="Primary"
									Content="Generate TEMP AUTH"
									Command="{Binding GenerateTempAuthCommand}"/>

						</Grid>

					</StackPanel>

				</Border>

			</Grid>

		</ScrollViewer>

	</Grid>

</UserControl>