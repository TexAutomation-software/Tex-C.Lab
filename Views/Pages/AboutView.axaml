<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:PCRA.ViewModels.Pages"
    x:Class="PCRA.Views.Pages.AboutView"
    x:DataType="vm:AboutViewModel">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">

        <StackPanel
            Margin="40"
            Width="620"
            HorizontalAlignment="Center"
            Spacing="20">

            <StackPanel
                HorizontalAlignment="Center"
                Spacing="6">

                <TextBlock
                    Text="About"
                    FontSize="28"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center" />

                <TextBlock
                    Text="Learn more about Tex C. Lab"
                    Classes="GeneratorSubtitle"
                    HorizontalAlignment="Center" />

            </StackPanel>

            <Border
                Classes="GeneratorCard"
                Padding="35">

                <StackPanel Spacing="22">

                    <StackPanel
                        HorizontalAlignment="Center"
                        Spacing="12">

                        <Border
                            Width="250"
                            Height="82"
                            CornerRadius="14"
                            HorizontalAlignment="Center"
                            Padding="20">

                            <Image
                                Source="/Assets/LogoTex.png"
                                Stretch="Uniform"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="210"
                                MaxHeight="52" />

                        </Border>

                        <StackPanel
                            HorizontalAlignment="Center"
                            Spacing="5">

                            <TextBlock
                                Text="Tex C. Lab"
                                FontSize="30"
                                FontWeight="Bold"
                                HorizontalAlignment="Center" />

                            <!--
                            <TextBlock
                                Text="TEX Controller Utility"
                                Classes="GeneratorSubtitle"
                                HorizontalAlignment="Center" />
                            -->

                        </StackPanel>

                    </StackPanel>

                    <Separator />

                    <StackPanel Spacing="14">

                        <TextBlock
                            Text="Application Information"
                            FontSize="17"
                            FontWeight="SemiBold" />

                        <Grid
                            ColumnDefinitions="150,*"
                            RowDefinitions="Auto,Auto,Auto"
                            RowSpacing="12">

                            <TextBlock
                                Text="Version"
                                FontWeight="SemiBold"
                                Opacity="0.7" />

                            <TextBlock
                                Grid.Column="1"
                                Text="{Binding Version}"
                                HorizontalAlignment="Right" />

                            <TextBlock
                                Grid.Row="1"
                                Text="Platform"
                                FontWeight="SemiBold"
                                Opacity="0.7" />

                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="1"
                                Text="Avalonia UI"
                                HorizontalAlignment="Right" />

                            <TextBlock
                                Grid.Row="2"
                                Text="Developer"
                                FontWeight="SemiBold"
                                Opacity="0.7" />

                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="1"
                                Text="Tex Computer Srl"
                                HorizontalAlignment="Right" />

                        </Grid>

                    </StackPanel>

                    <Separator />

                    <StackPanel Spacing="8">

                        <TextBlock
                            Text="Overview"
                            FontSize="17"
                            FontWeight="SemiBold" />

                        <TextBlock
                            Text="A desktop utility for generating encrypted files used in Tex controller configuration and authorization workflows."
                            TextWrapping="Wrap"
                            LineHeight="21"
                            Opacity="0.75" />

                    </StackPanel>

                    <Separator />

                    <StackPanel Spacing="10">

                        <TextBlock
                            Text="Documentation"
                            FontSize="17"
                            FontWeight="SemiBold" />

                        <TextBlock
                            Text="View the latest application changes and releases."
                            TextWrapping="Wrap"
                            Opacity="0.75" />

                        <Button
                            Content="Open Changelog"
                            Command="{Binding OpenChangelogCommand}"
                            HorizontalAlignment="Left"
                            Padding="18,9"
                            MinWidth="160" />

                    </StackPanel>

                </StackPanel>

            </Border>

            <TextBlock
                Text="© 2026 Tex Computer Srl All rights reserved."
                Classes="GeneratorSubtitle"
                HorizontalAlignment="Center"
                Opacity="0.6" />

        </StackPanel>

    </ScrollViewer>

</UserControl>